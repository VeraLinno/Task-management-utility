{
  "name": "visualstudioprojekts",
  "version": "1.0.0",
  "description": "A fully-typed Task Manager application migrated from JavaScript to TypeScript with enhanced features including recurring tasks, task dependencies, statistics, and improved search/sort capabilities.",
  "main": "index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=dist/main.js --format=esm --target=es2020",
    "dev": "esbuild src/index.ts --bundle --outfile=dist/main.js --format=esm --target=es2020 --watch --servedir=. --serve=0.0.0.0:8080",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:ci": "node --import tsx --test tests/**/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.15.30",
    "esbuild": "^0.27.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
